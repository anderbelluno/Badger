<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="13"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="EpollPing"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <Units>
      <Unit>
        <Filename Value="EpollPing.lpr"/>
      </Unit>
      <Unit>
        <Filename Value="../../../src/Badger.pas"/>
      </Unit>
      <Unit>
        <Filename Value="../../../src/Epoll/BadgerEpoll.pas"/>
      </Unit>
      <Unit>
        <Filename Value="../../../src/Epoll/BadgerEpollSys.pas"/>
      </Unit>
      <Unit>
        <Filename Value="../../../src/BadgerHttpDispatch.pas"/>
      </Unit>
      <Unit>
        <Filename Value="../EpollDemoRoutes.pas"/>
      </Unit>
      <Unit>
        <Filename Value="../../IOCP/IocpDemoHttpRoutes.pas"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="EpollPing"/>
      <TargetOS Value="linux"/>
      <TargetCPU Value="x86_64"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir);../../../src"/>
      <OtherUnitFiles Value="../../../src/Epoll;../../../src;../../../src/Auth/Basic;../../../src/Auth/JWT;../../IOCP;..;../../../ThirdParty/Synapse;../../../ThirdParty/SuperObject/D_Plus_Laz_Linux"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
    </Linking>
  </CompilerOptions>
</CONFIG>
