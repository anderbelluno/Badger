<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="13"/>
    <PathDelim Value="\"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="EpollPing"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <Units>
      <Unit>
        <Filename Value="EpollPing.lpr"/>
      </Unit>
      <Unit>
        <Filename Value="..\..\..\src\Epoll\BadgerEpoll.pas"/>
      </Unit>
      <Unit>
        <Filename Value="..\..\..\src\Epoll\BadgerEpollSys.pas"/>
      </Unit>
      <Unit>
        <Filename Value="..\..\..\src\BadgerHttpDispatch.pas"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="EpollPing"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir);..\..\..\src"/>
      <OtherUnitFiles Value="..\..\..\src\Epoll;..\..\..\src;..\..\..\src\IOCP;..\..\..\ThirdParty\Synapse"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf4"/>
      </Debugging>
    </Linking>
  </CompilerOptions>
</CONFIG>
