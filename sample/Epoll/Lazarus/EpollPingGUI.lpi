<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="13"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="EpollPingGUI"/>
      <Scaled Value="True"/>
      <ResourceType Value="none"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="EpollPingGUI.lpr"/>
      </Unit>
      <Unit>
        <Filename Value="MainForm.pas"/>
        <ComponentName Value="FormMain"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="../../../src/Epoll/BadgerEpoll.pas"/>
      </Unit>
      <Unit>
        <Filename Value="../../../src/Epoll/BadgerEpollSys.pas"/>
      </Unit>
      <Unit>
        <Filename Value="../../../src/BadgerHttpDispatch.pas"/>
      </Unit>
      <Unit>
        <Filename Value="../EpollDemoRoutes.pas"/>
      </Unit>
      <Unit>
        <Filename Value="../../IOCP/IocpDemoHttpRoutes.pas"/>
      </Unit>
      <Unit>
        <Filename Value="../../IOCP/IocpWsChatClient.pas"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="EpollPingGUI"/>
      <TargetOS Value="linux"/>
      <TargetCPU Value="x86_64"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir);../../../src"/>
      <OtherUnitFiles Value="../../../src/Epoll;../../../src;../../../src/Auth/Basic;../../../src/Auth/JWT;../../IOCP;..;../../../ThirdParty/Synapse;../../../ThirdParty/SuperObject/D_Plus_Laz_Linux"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
    </Linking>
  </CompilerOptions>
</CONFIG>
