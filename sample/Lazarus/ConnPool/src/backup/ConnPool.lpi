<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="13"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="ConnPool"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="zcomponentdesign"/>
      </Item>
      <Item>
        <PackageName Value="zcomponent"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="ConnPool.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="unit1.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="Form1"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="Unit1"/>
      </Unit>
      <Unit>
        <Filename Value="unit2.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="DataModule1"/>
        <ResourceBaseClass Value="DataModule"/>
        <UnitName Value="Unit2"/>
      </Unit>
      <Unit>
        <Filename Value="ConnPoolRoutes.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="ConnPoolRoutes"/>
      </Unit>
      <Unit>
        <Filename Value="ConnPoolWorkers.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="ConnPoolWorkers"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="ConnPool"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir);../../../../src"/>
      <OtherUnitFiles Value="../../../../src;../../../../src/DBPool;../../../../src/Auth/Basic;../../../../src/Auth/JWT;../../../../ThirdParty/Synapse;../../../../ThirdParty/SuperObject/D_Plus_Laz_Linux"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Parsing>
      <SyntaxOptions>
        <SyntaxMode Value="Delphi"/>
      </SyntaxOptions>
    </Parsing>
    <Linking>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
